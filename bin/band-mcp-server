#!/usr/bin/env ruby
# frozen_string_literal: true

# stdout carries the MCP protocol; write any diagnostics to $stderr.
# Assigned unconditionally: a BUNDLE_GEMFILE inherited from the client's own Bundler context would load the wrong gems.
ENV["BUNDLE_GEMFILE"] = File.expand_path("../Gemfile", __dir__)
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "bundler/setup"
require "band_mcp"

BandMCP::Config.load_dotenv
MCP::Server::Transports::StdioTransport.new(BandMCP.build_server).open
